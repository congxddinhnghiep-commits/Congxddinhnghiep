# Môi trường: để trống khi phát triển / chạy trên máy cá nhân; đặt production khi triển khai web
NODE_ENV=
# Cổng chạy ứng dụng
PORT=3000
# Thư mục dữ liệu và file CSDL (mặc định ./data và ./data/dutoan.db)
DATA_DIR=
DB_PATH=
# Tài khoản quản trị khởi tạo (bắt buộc đổi mật khẩu ở lần đăng nhập đầu)
ADMIN_USER=admin
ADMIN_PASS=admin123
# Khóa ký JWT — BẮT BUỘC đặt giá trị ngẫu nhiên, dài khi chạy trên web
JWT_SECRET=
# Cho phép nhập file theo đường dẫn tuyệt đối trên máy (chỉ bật khi chạy cục bộ)
LOCAL_MODE=true
# Google Drive (tùy chọn) — xem docs/google-drive-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Trợ lý AI cá nhân (ChatGPT hoặc Claude) – tùy chọn.
# Khóa API CHỈ đặt ở đây (file .env đã được .gitignore) hoặc ở biến môi trường của máy chủ / Codespaces secrets.
# Khóa không bao giờ được gửi xuống trình duyệt, không ghi log, không lưu vào CSDL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Nhà cung cấp mặc định: openai | anthropic | offline (bỏ trống = tự chọn theo khóa có sẵn). Màn hình “Trợ lý AI” có thể đổi.
AI_PROVIDER=
# Giới hạn cho mỗi yêu cầu: số bước gọi công cụ, tổng token đầu ra, thời gian chờ (ms)
AI_MAX_ITERATIONS=6
AI_MAX_OUTPUT_TOKENS=6000
AI_TIMEOUT_MS=60000
